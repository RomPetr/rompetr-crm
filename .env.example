# Пример конфигурации CRM. Скопируйте в .env и заполните реальными значениями.
# .env никогда не коммитится.

APP_ENV=dev
APP_NAME=rompetr-crm
APP_BASE_URL=http://127.0.0.1:8000
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TZ=Asia/Irkutsk
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://rompetr_app:change-me@127.0.0.1:5432/rompetr
DB_POOL_SIZE=5
DB_ECHO=false

SESSION_COOKIE_NAME=crm_session
SESSION_TTL_DAYS=14
SESSION_ABSOLUTE_DAYS=30
COOKIE_SECURE=false

ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADM_PASSW=change-me-min-16-chars
ADMIN_BOOTSTRAP=1

EMAIL_MODE=dev
MAIL_FROM=crm@rompetr.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

MEDIA_ROOT=var/media
POSTS_ROOT=posts
MAX_UPLOAD_MB=10

RATE_LIMIT_LOGIN=5/min
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_RESET=3/hour

PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru
IMAGE_MODEL=black-forest-labs/flux.2-pro
IMAGE_FALLBACK_MODEL=gpt-image-1-mini

VK_ACCESS_TOKEN=
VK_GROUP_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

X_MODE=manual

CLAUDE_BIN=claude
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CONFIG_DIR=
CLAUDE_MODEL=sonnet
CLAUDE_FALLBACK_MODEL=
CLAUDE_TIMEOUT_SEC=900
CLAUDE_MAX_CONCURRENCY=1
CLAUDE_MAX_TURNS=20
CLAUDE_MAX_BUDGET_USD=2

WORKER_POLL_SEC=2
WORKER_ID=local-1
WORKER_INPROCESS=false

FEATURE_AI_CHECK=true
FEATURE_COMPOSE=false
